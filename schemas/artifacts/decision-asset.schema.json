{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyogas.local/schemas/artifacts/decision-asset.schema.json",
  "title": "DecisionAsset",
  "description": "Decision Asset derived from Research evidence (SPRINT-DECISION-ASSET-AGENT-FOUNDATION-001).",
  "type": "object",
  "required": [
    "asset_id",
    "title",
    "question",
    "summary",
    "claims",
    "evidence_ids",
    "research_artifact_id",
    "tenant_id",
    "task_id",
    "status",
    "requires_human_approval"
  ],
  "additionalProperties": false,
  "properties": {
    "asset_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "evidence_id"],
        "additionalProperties": false,
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "evidence_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "research_artifact_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "execution_package_task_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "pending_approval", "approved", "rejected", "applied"]
    },
    "requires_human_approval": { "const": true }
  }
}
