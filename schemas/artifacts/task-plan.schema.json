{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyogas.local/schemas/artifacts/task-plan.schema.json",
  "title": "TaskPlan",
  "description": "Task Agent planning output — maps to Execution Package fields (SPRINT-TASK-AGENT-FOUNDATION-001).",
  "type": "object",
  "required": [
    "plan_id",
    "task_id",
    "title",
    "objective",
    "tenant_id",
    "run_id",
    "sprint_id",
    "steps",
    "package_fields",
    "requires_human_approval",
    "routed_agent_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "sprint_id": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "title", "agent_id", "depends_on"],
        "additionalProperties": false,
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "agent_id": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "objective": { "type": "string" }
        }
      }
    },
    "package_fields": {
      "type": "object",
      "required": [
        "acceptanceCriteria",
        "testRequirements",
        "allowedScope",
        "forbiddenScope",
        "expectedEvidence",
        "ssotReferences",
        "gapRegistry"
      ],
      "additionalProperties": false,
      "properties": {
        "acceptanceCriteria": { "type": "string", "minLength": 1 },
        "testRequirements": { "type": "string", "minLength": 1 },
        "allowedScope": { "type": "string", "minLength": 1 },
        "forbiddenScope": { "type": "string", "minLength": 1 },
        "expectedEvidence": { "type": "string", "minLength": 1 },
        "ssotReferences": { "type": "string", "minLength": 1 },
        "gapRegistry": { "type": "string", "minLength": 1 },
        "executionMode": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "requires_human_approval": { "const": true },
    "routed_agent_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "research_brief": {
      "type": "object",
      "description": "Host-compatible ResearchBrief-shaped fields for Stage-1 bootstrap (no Host redesign).",
      "required": ["question", "scope", "allowed_source_classes", "budget"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "allowed_source_classes": {
          "type": "array",
          "items": { "type": "string", "enum": ["youtube", "github", "reddit", "web"] },
          "minItems": 1
        },
        "budget": {
          "type": "object",
          "required": ["max_items"],
          "additionalProperties": false,
          "properties": {
            "max_items": { "type": "integer", "minimum": 1 },
            "max_seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
