{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyogas.local/schemas/artifacts/decision-dna.schema.json",
  "title": "DecisionDNA",
  "description": "Decision DNA v0.1 snapshot aggregated from Decision Model records (SPRINT-DECISION-INTELLIGENCE-FOUNDATION-001). Not a Decision Agent; not a prediction engine.",
  "type": "object",
  "required": [
    "dna_id",
    "tenant_id",
    "model_refs",
    "decision_patterns",
    "preference_signals",
    "constraint_patterns",
    "risk_profile",
    "created_at",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "dna_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "model_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_id", "description", "frequency", "model_refs"],
        "additionalProperties": false,
        "properties": {
          "pattern_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "frequency": { "type": "integer", "minimum": 1 },
          "model_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "preference_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_id", "key", "value", "frequency"],
        "additionalProperties": false,
        "properties": {
          "signal_id": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "frequency": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "constraint_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_id", "constraint_key", "observed_values", "frequency"],
        "additionalProperties": false,
        "properties": {
          "pattern_id": { "type": "string", "minLength": 1 },
          "constraint_key": { "type": "string", "minLength": 1 },
          "observed_values": {
            "type": "array",
            "items": { "type": "string" }
          },
          "frequency": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "risk_profile": {
      "type": "object",
      "required": ["profile_id", "signals", "summary"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "const": "0.1.0" },
    "decision_domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "lineage_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_id"],
        "additionalProperties": false,
        "properties": {
          "model_id": { "type": "string", "minLength": 1 },
          "knowledge_ref": { "type": "string" },
          "approval_ref": { "type": "string" },
          "graph_update_ref": { "type": "string" }
        }
      }
    }
  }
}
