{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyogas.local/schemas/artifacts/human-review-decision.schema.json",
  "title": "HumanReviewDecision",
  "description": "Attributable gate outcome for a Proposal (and optional draft Knowledge), including apply/continue token when approved. See /artifacts/human-review-decision.md.",
  "type": "object",
  "required": ["subject_refs", "outcome", "checklist_id", "review_findings"],
  "additionalProperties": false,
  "properties": {
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "description": "Artifacts under review, typically the sealed Proposal and optionally a draft Knowledge.",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_version", "artifact_type"],
        "properties": {
          "artifact_id": { "type": "string" },
          "artifact_version": { "type": "string" },
          "artifact_type": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string",
      "description": "Gate outcome. pending until a human acts. approved mints a single-use apply_token; rejected/expired never carry a token.",
      "enum": ["pending", "approved", "rejected", "request_changes", "expired", "escalated"]
    },
    "checklist_id": {
      "type": "string",
      "description": "Identifier of the governed review checklist applied.",
      "examples": ["checklist-knowledge-approval-1.0.0"]
    },
    "review_findings": {
      "type": "array",
      "description": "Structured findings from the Knowledge Review Agent (and any human-added notes).",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "examples": ["CITATION_WEAK", "SCOPE_CREEP"] },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "approver": {
      "type": "object",
      "description": "Required whenever outcome is not pending. The attributable identity anchor for the decision.",
      "properties": {
        "actor_id": { "type": "string", "examples": ["user:jdoe@acme.example"] },
        "decided_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "apply_token": {
      "type": "string",
      "description": "Single-use, version-bound token. Required when outcome=approved; forbidden when outcome=rejected.",
      "examples": ["at_01J8Z7V9W0X1Y2Z3A4B5C6D7E8.single-use.bound=pr-01J8Z5S6T7U8V9W0X1Y2Z3A4B5@1.0.0"]
    },
    "change_requests": {
      "type": "array",
      "description": "Specific, actionable changes required, populated when outcome=request_changes.",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "approved" } }
      },
      "then": {
        "required": ["approver", "apply_token"]
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "rejected" } }
      },
      "then": {
        "not": { "required": ["apply_token"] }
      }
    }
  ],
  "examples": [
    {
      "subject_refs": [{ "artifact_id": "pr-01J8Z5S6T7U8V9W0X1Y2Z3A4B5", "artifact_version": "1.0.0", "artifact_type": "Proposal" }],
      "outcome": "approved",
      "checklist_id": "checklist-knowledge-approval-1.0.0",
      "review_findings": [{ "code": "CITATION_WEAK", "severity": "low", "message": "cit-02 is a vendor blog, not a spec; acceptable but note for reviewer." }],
      "approver": { "actor_id": "user:jdoe@acme.example", "decided_at": "2026-07-22T10:30:00Z" },
      "apply_token": "at_01J8Z7V9W0X1Y2Z3A4B5C6D7E8.single-use.bound=pr-01J8Z5S6T7U8V9W0X1Y2Z3A4B5@1.0.0"
    }
  ]
}
